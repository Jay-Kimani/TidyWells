/*LEARN*/
.rps{max-height:calc(100vh - 100px);overflow:auto}
ul.toc{list-style:none;padding:0;margin:0}ul.toc li{margin:0;border-bottom:1px solid var(--line)}ul.toc li:last-child{border:0}ul.toc a{display:block;padding:7px 0;text-decoration:none;color:var(--fg);font-weight:500}ul.toc a:hover{color:var(--accent)}
.rpm pre{overflow-x:auto;margin:12px 0}
.gp main{max-width:860px}
.gp .az{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0 18px}.gp .az a{min-width:34px;text-align:center;padding:5px 9px;border:1px solid var(--line);border-radius:6px;background:var(--panel);text-decoration:none;font-weight:600;color:var(--accent)}.gp .az a:hover{border-color:var(--accent)}
.gp dl.gl{margin:0}.gp .gi{padding:14px 0;border-bottom:1px solid var(--line)}.gp .gi[hidden]{display:none}
.gp dt{font:600 19px/1.3 var(--serif);margin:0 0 4px;scroll-margin-top:90px}.gp dd{margin:0;color:var(--muted);max-width:68ch}
.gp .sbox input{width:100%;max-width:none;border:1.5px solid #9a917d;border-radius:8px;background:#fff;color:#1a2238;padding:13px 16px;font:400 16px Inter,sans-serif}
:root[data-theme=dark] .gp .sbox input{border-color:#fff}
/*/LEARN*/
